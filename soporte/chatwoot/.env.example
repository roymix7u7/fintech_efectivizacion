# Copia este archivo como .env y cambia los valores marcados.
# .env nunca se sube al repositorio.

# Clave larga al azar (openssl rand -hex 64).
SECRET_KEY_BASE=cambia_esto

# Dirección con la que se entra a Chatwoot. En la PC es localhost;
# con túnel o servidor, la URL pública con https.
FRONTEND_URL=http://localhost:3200
FORCE_SSL=false

# Nadie crea cuentas por su cuenta: a los asesores se les invita.
ENABLE_ACCOUNT_SIGNUP=false

# Base de datos y Redis (solo dentro de Docker).
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=cambia_esto
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=cambia_esto

RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Correo para invitar asesores y avisarles, por Resend (el mismo que usa
# Supabase). El remitente debe ser del dominio verificado en Resend y la
# clave, una API key propia para Chatwoot (permiso "Sending access").
# Sin SMTP, Chatwoot funciona pero no manda correos.
MAILER_SENDER_EMAIL=AlToque Soporte <soporte@tu-dominio-verificado>
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Adjuntos del chat en Cloudflare R2 (bucket privado). La clave es un
# "Account API token" con permiso Object Read & Write solo para este
# bucket. Para guardarlos en disco: ACTIVE_STORAGE_SERVICE=local.
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=altoque-chat-adjuntos
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
STORAGE_FORCE_PATH_STYLE=true
# R2 rechaza las dos verificaciones que manda la librería nueva de AWS:
# que agregue la suya solo cuando sea obligatoria.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# Antisaturación del chat (por IP y por chat, cada minuto). Un cliente real
# no llega ni cerca; un bot sí. Los celulares de una misma operadora
# pueden compartir IP: por eso no se baja más.
RATE_LIMIT_WIDGET_CONVERSATIONS=10
RATE_LIMIT_WIDGET_MESSAGES=30
RATE_LIMIT_WIDGET_CONTACTS=30
