<%# Copia en español de la vista de Chatwoot v4.19.1 (ver confirmation_instructions.html.erb). %>
<% reset_password_params = { reset_password_token: @token } %>
<% reset_password_params[:route_url] = params[:redirect_url] if params[:redirect_url].present? %>
<% reset_password_params[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present? %>
<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: 'Crear una contraseña nueva',
  action_url: frontend_url('auth/password/edit', **reset_password_params),
  detail_rows: [],
  eyebrow: 'Contraseña',
  heading: 'Cambia tu contraseña',
  info_text: nil,
  info_title: nil,
  intro_text: 'Alguien pidió cambiar la contraseña de tu cuenta de atención al cliente. Puedes hacerlo con el botón de abajo.',
  recipient_name: @resource.name.presence || @resource.email,
  supporting_text: 'Si no lo pediste tú, ignora este correo: tu contraseña no cambia hasta que crees una nueva.'
} %>
