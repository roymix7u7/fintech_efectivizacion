# Copia este archivo como ".env" y completa los valores.
# Genera las dos claves con:  docker compose run --rm chat node src/cli.js secrets

# Contraseña de la base de datos del chat (solo la usan estos contenedores).
POSTGRES_PASSWORD=cambia_esto

# Dirección pública del chat, con https y sin barra final.
PUBLIC_URL=https://chat2.panel-admin-atk-mobil.com

# Firma las sesiones. Si la cambias, todos tienen que volver a entrar.
JWT_SECRET=cambia_esto

# Administrador del chat. Solo se usa en el primer arranque (12 caracteres o más).
ADMIN_EMAIL=admin@altoqueperu.com
ADMIN_PASSWORD=cambia_esto

# Dominios de la web desde donde se puede mostrar el chat (luego los ajusta configurar.mjs).
SEED_ALLOWED_DOMAINS=www.panel-admin-atk-mobil.com,panel-admin-atk-mobil.com

# Adjuntos en Cloudflare R2 (recomendado). Vacío = en el volumen del servidor.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Respaldo diario de la base (hora de Lima) y días que se conservan.
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30
